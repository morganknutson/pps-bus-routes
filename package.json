{
  "name": "pps-bus-maps",
  "version": "1.0.0",
  "description": "Bus route mapping app that parses PDFs from Google Drive",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm run build",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "download-routes": "node scripts/download-via-api.js",
    "process-pdf": "node scripts/process-single-pdf.js"
  },
  "keywords": ["bus", "routes", "maps", "pdf", "google-drive"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

