{
  "name": "pps-bus-maps",
  "version": "1.0.0",
  "description": "Bus route mapping app that parses PDFs from Google Drive",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm install && npm run build",
    "build:all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd ../frontend && npm run build",
    "start:production": "cd backend && node server.js",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install",
    "download-routes": "node scripts/download-via-api.js",
    "process-pdf": "node scripts/process-single-pdf.js",
    "discover-links": "node scripts/discover-school-links.js",
    "verify-links": "node scripts/verify-school-links.js",
    "download-pdfs": "node scripts/download-all-school-pdfs.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:save": "pm2 save"
  },
  "keywords": [
    "bus",
    "routes",
    "maps",
    "pdf",
    "google-drive"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "pm2": "^6.0.14"
  }
}
