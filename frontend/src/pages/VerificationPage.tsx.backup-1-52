import React, { useState, useEffect } from 'react';
import { Header } from '../components/Header';
import { ProgressBar } from '../components/ProgressBar';
import { useIsMobile } from '../hooks/useMediaQuery';

export function VerificationPage() {
  const isMobile = useIsMobile();
  const [pdfStatus, setPdfStatus] = useState<any>(null);
  const [syncStatus, setSyncStatus] = useState<Record<string, { lastModifiedPdf?: string; lastChecked?: string }>>({});
  const [processingStatus, setProcessingStatus] = useState<Record<string, boolean | { hasProcessed: boolean; lastProcessed: string | null }>>({});
  const [fetching, setFetching] = useState<Record<string, boolean>>({});
  const [processing, setProcessing] = useState<Record<string, boolean>>({});
  const [pdfProcessingStatus, setPdfProcessingStatus] = useState<Record<string, Record<string, 'pending' | 'processing' | 'success' | 'error'>>>({});
  const [expandedRows, setExpandedRows] = useState<Record<string, boolean>>({});
  const [allRoutes, setAllRoutes] = useState<Record<string, Record<string, any>>>({});
  const [loadingRoutes, setLoadingRoutes] = useState<Record<string, boolean>>({});
  const [loading, setLoading] = useState(true);
  const [loadingProgress, setLoadingProgress] = useState<number | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [jobStatuses, setJobStatuses] = useState<Record<string, any>>({});
  const [shouldPollJobs, setShouldPollJobs] = useState(false);
  const [successMessages, setSuccessMessages] = useState<Record<string, string>>({});
  const [refreshing, setRefreshing] = useState(false);
  const [pdfFetchInfo, setPdfFetchInfo] = useState<Record<string, any>>({});
  const [driveLinkResults, setDriveLinkResults] = useState<any>(null);
  const [checkingDriveLinks, setCheckingDriveLinks] = useState(false);
  const [checkAllProgress, setCheckAllProgress] = useState<{ queued: number; total: number } | null>(null);
  const [checkingSchool, setCheckingSchool] = useState<Record<string, boolean>>({});
  const [fetchingAll, setFetchingAll] = useState(false);
  const [fetchAllProgress, setFetchAllProgress] = useState<{ queued: number; total: number } | null>(null);
  const [fixingAll, setFixingAll] = useState(false);
  const [findingStrangeStops, setFindingStrangeStops] = useState(false);
  const [strangeStopsReport, setStrangeStopsReport] = useState<any>(null);
  const [verifyingSchoolStops, setVerifyingSchoolStops] = useState(false);
  const [schoolStopsReport, setSchoolStopsReport] = useState<any>(null);
  const [fixingStops, setFixingStops] = useState(false);
  const [fixStopsResult, setFixStopsResult] = useState<any>(null);
  const [fixAllStatus, setFixAllStatus] = useState<{
    phase: 'idle' | 'fetching' | 'waiting-fetch' | 'processing' | 'waiting-process' | 'complete';
    fetchQueued: number;
    fetchTotal: number;
    processQueued: number;
    processTotal: number;
    message: string;
  }>({ phase: 'idle', fetchQueued: 0, fetchTotal: 0, processQueued: 0, processTotal: 0, message: '' });
  const [jobQueueStats, setJobQueueStats] = useState<{
    waiting: number;
    active: number;
    completed: number;
    failed: number;
    total: number;
    isRedisAvailable?: boolean;
  } | null>(null);
  const [activeJobs, setActiveJobs] = useState<any[]>([]);
  const [fetchMessages, setFetchMessages] = useState<Record<string, { type: 'info' | 'success' | 'error'; message: string }>>({});
  const [activeTab, setActiveTab] = useState<'attention' | 'all'>('attention');

  // Define all functions before useEffects
  const loadJobQueueStats = async () => {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 3000);
      
      const response = await fetch('/api/jobs/stats', { signal: controller.signal });
      clearTimeout(timeoutId);
      
      if (response.ok) {
        const stats = await response.json();
        setJobQueueStats(stats);
      }
    } catch (err: any) {
      if (err.name !== 'AbortError') {
        console.warn('[VerificationPage] Error loading job stats (non-fatal):', err.message || err);
      }
    }
  };

  const loadJobStatuses = async () => {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 5000);
      
      const response = await fetch('/api/jobs?limit=100', {
        signal: controller.signal,
      });
      
      clearTimeout(timeoutId);
      
      if (response.ok) {
        const data = await response.json();
        const statusMap: Record<string, any> = {};
        const activeJobsList: any[] = [];
        
        data.jobs.forEach((job: any) => {
          if (job.data.schoolId) {
            statusMap[job.data.schoolId] = job;
          }
          if (job.status === 'active' || job.status === 'waiting') {
            activeJobsList.push(job);
          }
        });
        
        setJobStatuses(statusMap);
        setActiveJobs(activeJobsList);
      }
    } catch (err: any) {
      if (err.name !== 'AbortError') {
        console.warn('[VerificationPage] Error loading job statuses (non-fatal):', err.message || err);
      }
    }
  };

  const loadPdfStatus = async () => {
    try {
      const response = await fetch(`/api/pdf-status/status?refresh=1&t=${Date.now()}`, {
        cache: 'no-store',
        headers: {
          'Cache-Control': 'no-cache',
        },
      });
      
      if (!response.ok) {
        const errorMsg = `Failed to load PDF status: ${response.status} ${response.statusText}`;
        setError(errorMsg);
        throw new Error(errorMsg);
      }
      
      const data = await response.json();
      setPdfStatus(data);
      setError(null);
      setShouldPollJobs(true);
    } catch (err: any) {
      setError(`Failed to load PDF status: ${err.message || 'Network error'}`);
      throw err;
    }
  };

  const loadSyncStatus = async () => {
    try {
      const response = await fetch('/api/pdf-sync/status');
      if (response.ok) {
        const data = await response.json();
        setSyncStatus(data || {});
      }
    } catch (err: any) {
      console.error('Failed to load sync status:', err);
    }
  };

  const loadPdfFetchInfo = async () => {
    try {
      const response = await fetch('/api/verification/pdf-fetch-info');
      if (response.ok) {
        const data = await response.json();
        setPdfFetchInfo(data || {});
      }
    } catch (err: any) {
      console.error('[VerificationPage] Failed to load PDF fetch info:', err);
    }
  };

  const loadDriveLinkResults = async () => {
    try {
      const response = await fetch('/api/verification/drive-link-results');
      if (response.ok) {
        const data = await response.json();
        setDriveLinkResults(data);
      } else if (response.status === 404) {
        setDriveLinkResults(null);
      }
    } catch (err: any) {
      console.error('[VerificationPage] Failed to load Drive link results:', err);
      setDriveLinkResults(null);
    }
  };

  const checkSingleSchoolDriveLink = async (schoolId: string) => {
    try {
      setCheckingSchool(prev => ({ ...prev, [schoolId]: true }));
      const response = await fetch(`/api/verification/check-drive-link/${schoolId}`, {
        method: 'POST',
      });
      if (response.ok) {
        setSuccessMessages(prev => ({ ...prev, [schoolId]: 'Drive check queued...' }));
        setTimeout(() => {
          setSuccessMessages(prev => {
            const updated = { ...prev };
            if (updated[schoolId] === 'Drive check queued...') delete updated[schoolId];
            return updated;
          });
        }, 3000);
      }
    } catch (err: any) {
      setSuccessMessages(prev => ({ ...prev, [schoolId]: `Error: ${err.message}` }));
    } finally {
      setCheckingSchool(prev => ({ ...prev, [schoolId]: false }));
    }
  };

  const handleCheckDriveLinks = async () => {
    if (!pdfStatus?.schools) return;
    const schoolsWithDriveLinks = pdfStatus.schools.filter((school: any) => school.driveLink);
    if (schoolsWithDriveLinks.length === 0) return;
    
    setCheckingDriveLinks(true);
    setCheckAllProgress({ queued: 0, total: schoolsWithDriveLinks.length });
    
    try {
      let queued = 0;
      for (const school of schoolsWithDriveLinks) {
        const response = await fetch(`/api/verification/check-drive-link/${school.schoolId}`, { method: 'POST' });
        if (response.ok) {
          queued++;
          setCheckAllProgress({ queued, total: schoolsWithDriveLinks.length });
        }
      }
      
      await loadJobStatuses();
      await loadJobQueueStats();
      setCheckAllProgress(null);
      
      const pollInterval = setInterval(async () => {
        const statsResponse = await fetch('/api/jobs/stats');
        if (statsResponse.ok) {
          const stats = await statsResponse.json();
          setJobQueueStats(stats);
          if (stats.waiting === 0 && stats.active === 0) {
            clearInterval(pollInterval);
            setCheckingDriveLinks(false);
            await Promise.all([loadPdfStatus(), loadSyncStatus(), loadPdfFetchInfo(), loadDriveLinkResults(), loadJobStatuses()]);
          }
        }
      }, 5000);
    } catch (err) {
      setCheckingDriveLinks(false);
    }
  };

  const loadProcessingStatus = async () => {
    try {
      const response = await fetch('/api/process-pdfs/status');
      if (response.ok) {
        const data = await response.json();
        setProcessingStatus(data || {});
      }
    } catch (err: any) {
      console.error('Failed to load processing status:', err);
    }
  };

  const handleRefreshStatus = async () => {
    setRefreshing(true);
    try {
      const response = await fetch('/api/pdf-status/refresh-status', { method: 'POST' });
      if (response.ok) {
        const data = await response.json();
        if (data.pdfStatus) setPdfStatus(data.pdfStatus);
        if (data.processingStatus) setProcessingStatus(data.processingStatus);
        await Promise.all([loadSyncStatus(), loadPdfFetchInfo()]);
      }
    } finally {
      setRefreshing(false);
    }
  };

  const handleFindStrangeStops = async () => {
    setFindingStrangeStops(true);
    try {
      const response = await fetch('/api/verification/find-strange-stops', { method: 'POST' });
      if (response.ok) {
        const data = await response.json();
        setStrangeStopsReport(data);
      }
    } finally {
      setFindingStrangeStops(false);
    }
  };

  const handleVerifySchoolStops = async () => {
    setVerifyingSchoolStops(true);
    try {
      const response = await fetch('/api/verification/verify-school-stops', { method: 'POST' });
      if (response.ok) {
        const data = await response.json();
        setSchoolStopsReport(data);
      }
    } finally {
      setVerifyingSchoolStops(false);
    }
  };

  const handleFixStrangeStops = async () => {
    if (!window.confirm('This will modify processed route files. Are you sure?')) return;
    setFixingStops(true);
    try {
      const response = await fetch('/api/verification/fix-strange-stops', { method: 'POST' });
      if (response.ok) {
        const data = await response.json();
        setFixStopsResult(data);
        await handleRefreshStatus();
      }
    } finally {
      setFixingStops(false);
    }
  };

  useEffect(() => {
    const root = document.getElementById('root');
    if (root) {
      root.style.height = 'auto';
      root.style.minHeight = '100vh';
      root.style.overflowY = 'auto';
    }
    return () => {
      if (root) {
        root.style.height = '100vh';
        root.style.overflowY = 'hidden';
      }
    };
  }, []);

  useEffect(() => {
    const loadAll = async () => {
      setLoading(true);
      try {
        await loadPdfStatus();
        await Promise.all([loadSyncStatus(), loadProcessingStatus(), loadJobStatuses(), loadPdfFetchInfo(), loadDriveLinkResults()]);
      } finally {
        setLoading(false);
      }
    };
    loadAll();
  }, []);

  useEffect(() => {
    if (!shouldPollJobs) return;
    const interval = setInterval(() => {
      loadJobStatuses();
      loadJobQueueStats();
    }, 3000);
    return () => clearInterval(interval);
  }, [shouldPollJobs]);

  const [lastCompletedJobIds, setLastCompletedJobIds] = useState<Set<string>>(new Set());
  useEffect(() => {
    const completedJobs = Object.values(jobStatuses).filter(job => job.status === 'completed');
    if (completedJobs.length === 0) return;
    const currentCompletedIds = new Set(completedJobs.map(j => j.id));
    const newCompletedJobs = completedJobs.filter(job => !lastCompletedJobIds.has(job.id));
    if (newCompletedJobs.length > 0) {
      const hasCompletedDriveCheck = newCompletedJobs.some(job => job.name === 'drive-check');
      const hasCompletedPdfSync = newCompletedJobs.some(job => job.name === 'pdf-sync');
      if (hasCompletedDriveCheck) {
        loadDriveLinkResults();
        loadPdfFetchInfo();
      }
      if (hasCompletedPdfSync) {
        setTimeout(async () => {
          await Promise.all([loadPdfStatus(), loadSyncStatus(), loadPdfFetchInfo(), loadDriveLinkResults()]);
        }, 500);
      }
      setLastCompletedJobIds(currentCompletedIds);
    }
  }, [jobStatuses, lastCompletedJobIds]);

  const handleFetchPdfs = async (schoolId: string) => {
    setFetching(prev => ({ ...prev, [schoolId]: true }));
    try {
      const response = await fetch(`/api/pdf-sync/fetch/${schoolId}`, { method: 'POST' });
      if (response.ok) {
        const result = await response.json();
        setFetchMessages(prev => ({ ...prev, [schoolId]: { type: 'info', message: 'Queued' } }));
        await loadJobStatuses();
        await loadJobQueueStats();
      }
    } finally {
      setFetching(prev => ({ ...prev, [schoolId]: false }));
    }
  };

  const handleFetchAllPdfs = async () => {
    if (!pdfStatus?.schools) return;
    const schoolsWithDriveLinks = pdfStatus.schools.filter((school: any) => school.driveLink);
    setFetchingAll(true);
    try {
      for (const school of schoolsWithDriveLinks) {
        await fetch(`/api/pdf-sync/fetch/${school.schoolId}`, { method: 'POST' });
      }
      await loadJobStatuses();
      await loadJobQueueStats();
    } finally {
      setFetchingAll(false);
    }
  };

  const handleFixAllMismatched = async () => {
    if (!driveLinkResults?.results) return;
    const schoolsNeedingFix = driveLinkResults.results.filter((r: any) => r.needsUpdate || r.countMismatch);
    if (schoolsNeedingFix.length === 0) return;
    if (!window.confirm(`Fix ${schoolsNeedingFix.length} schools?`)) return;
    
    setFixingAll(true);
    setFixAllStatus(prev => ({ ...prev, message: 'Starting...' }));
    try {
      for (const school of schoolsNeedingFix) {
        await fetch(`/api/pdf-sync/fetch/${school.schoolId}`, { method: 'POST' });
      }
      // Wait logic simplified for UI cleanup
      setFixAllStatus(prev => ({ ...prev, message: 'Jobs Queued' }));
    } finally {
      setFixingAll(false);
    }
  };

  const handleProcessPdfs = async (schoolId: string) => {
    setProcessing(prev => ({ ...prev, [schoolId]: true }));
    try {
      await fetch(`/api/process-pdfs/process/${schoolId}`, { method: 'POST' });
      await loadProcessingStatus();
    } finally {
      setProcessing(prev => ({ ...prev, [schoolId]: false }));
    }
  };

  const loadAllRoutes = async (schoolId: string, forceReload = false) => {
    if (allRoutes[schoolId] && !forceReload) return;
    setLoadingRoutes(prev => ({ ...prev, [schoolId]: true }));
    try {
      const response = await fetch(`/api/data/routes?schoolId=${encodeURIComponent(schoolId)}`);
      if (response.ok) {
        const data = await response.json();
        const routesByFilename: Record<string, any> = {};
        (data.routes || []).forEach((r: any) => { if (r.filename) routesByFilename[r.filename] = r; });
        setAllRoutes(prev => ({ ...prev, [schoolId]: routesByFilename }));
      }
    } finally {
      setLoadingRoutes(prev => ({ ...prev, [schoolId]: false }));
    }
  };

  const handleRowExpand = (schoolId: string) => {
    const isExpanding = !expandedRows[schoolId];
    setExpandedRows(prev => ({ ...prev, [schoolId]: !prev[schoolId] }));
    if (isExpanding) loadAllRoutes(schoolId, true);
  };

  const getJobStatusForSchool = (schoolId: string) => jobStatuses[schoolId] || null;

  if (loading) return (
    <div style={{ display: 'flex', flexDirection: 'column', minHeight: '100vh' }}>
      <Header />
      <div style={{ display: 'flex', justifyContent: 'center', alignItems: 'center', flex: 1 }}>
        <ProgressBar label="Loading..." progress={loadingProgress ?? undefined} />
      </div>
    </div>
  );

  if (error || !pdfStatus) return (
    <div style={{ display: 'flex', flexDirection: 'column', minHeight: '100vh' }}>
      <Header />
      <div style={{ padding: '2rem', textAlign: 'center' }}>
        <h2 style={{ color: '#c00' }}>Error</h2>
        <p>{error || 'Failed to load data'}</p>
      </div>
    </div>
  );

  const schoolsNeedingAttention = driveLinkResults?.results?.filter((r: any) => r.needsUpdate || r.error) || [];

  return (
    <div style={{ display: 'flex', flexDirection: 'column', minHeight: '100vh', backgroundColor: 'var(--bg-primary)' }}>
      <Header />
      <div style={{ padding: isMobile ? '1rem' : '1.5rem', maxWidth: '1600px', margin: '0 auto', width: '100%', flex: 1 }}>
        
        {/* Summary Row */}
        <div style={{ display: 'grid', gridTemplateColumns: isMobile ? 'repeat(2, 1fr)' : 'repeat(5, 1fr)', gap: '0.75rem', marginBottom: '1.5rem' }}>
          <div style={{ padding: '0.75rem', backgroundColor: 'var(--bg-secondary)', borderRadius: '8px', border: '1px solid var(--border-color)', textAlign: 'center' }}>
            <div style={{ fontSize: '1.25rem', fontWeight: 'bold' }}>{pdfStatus.totalSchools}</div>
            <div style={{ color: 'var(--text-secondary)', fontSize: '10px', textTransform: 'uppercase' }}>Schools</div>
          </div>
          <div style={{ padding: '0.75rem', backgroundColor: 'var(--bg-secondary)', borderRadius: '8px', border: '1px solid var(--border-color)', textAlign: 'center' }}>
            <div style={{ fontSize: '1.25rem', fontWeight: 'bold', color: '#4ECDC4' }}>{pdfStatus.summary.totalPdfs}</div>
            <div style={{ color: 'var(--text-secondary)', fontSize: '10px', textTransform: 'uppercase' }}>Local PDFs</div>
          </div>
          <div style={{ padding: '0.75rem', backgroundColor: 'var(--bg-secondary)', borderRadius: '8px', border: '1px solid var(--border-color)', textAlign: 'center' }}>
            <div style={{ fontSize: '1.25rem', fontWeight: 'bold', color: '#ffa500' }}>{schoolsNeedingAttention.length}</div>
            <div style={{ color: 'var(--text-secondary)', fontSize: '10px', textTransform: 'uppercase' }}>Updates Needed</div>
          </div>
          <div style={{ padding: '0.75rem', backgroundColor: 'var(--bg-secondary)', borderRadius: '8px', border: '1px solid var(--border-color)', textAlign: 'center' }}>
            <div style={{ fontSize: '1.25rem', fontWeight: 'bold', color: '#4ECDC4' }}>{Object.values(processingStatus).filter(s => typeof s === 'object' ? s.hasProcessed : s).length}</div>
            <div style={{ color: 'var(--text-secondary)', fontSize: '10px', textTransform: 'uppercase' }}>Processed</div>
          </div>
          <div style={{ padding: '0.75rem', backgroundColor: 'var(--bg-secondary)', borderRadius: '8px', border: '1px solid var(--border-color)', textAlign: 'center' }}>
            <div style={{ fontSize: '1.25rem', fontWeight: 'bold', color: activeJobs.length > 0 ? '#4ECDC4' : 'inherit' }}>{activeJobs.length}</div>
            <div style={{ color: 'var(--text-secondary)', fontSize: '10px', textTransform: 'uppercase' }}>Active Jobs</div>
          </div>
        </div>

        {/* Tab Header & Action Bar */}
        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '1rem', flexWrap: 'wrap', gap: '1rem', borderBottom: '1px solid var(--border-color)' }}>
          <div style={{ display: 'flex', gap: '0.5rem' }}>
            <button onClick={() => setActiveTab('attention')} style={{ padding: '0.75rem 1rem', background: 'none', border: 'none', borderBottom: activeTab === 'attention' ? '3px solid #4ECDC4' : '3px solid transparent', color: activeTab === 'attention' ? 'var(--text-primary)' : 'var(--text-secondary)', fontWeight: 'bold', cursor: 'pointer', marginBottom: '-1px' }}>
              ACTION REQUIRED ({schoolsNeedingAttention.length})
            </button>
            <button onClick={() => setActiveTab('all')} style={{ padding: '0.75rem 1rem', background: 'none', border: 'none', borderBottom: activeTab === 'all' ? '3px solid #4ECDC4' : '3px solid transparent', color: activeTab === 'all' ? 'var(--text-primary)' : 'var(--text-secondary)', fontWeight: 'bold', cursor: 'pointer', marginBottom: '-1px' }}>
              ALL SCHOOLS
            </button>
          </div>
          <div style={{ display: 'flex', gap: '0.5rem', marginBottom: '0.5rem' }}>
            <button onClick={handleCheckDriveLinks} disabled={checkingDriveLinks} style={{ padding: '0.5rem 1rem', borderRadius: '6px', border: '1px solid var(--border-color)', backgroundColor: 'var(--bg-secondary)', cursor: 'pointer', fontSize: '12px', fontWeight: '600' }}>
              <i className={`fas ${checkingDriveLinks ? 'fa-spin fa-sync' : 'fa-sync-alt'}`} style={{ marginRight: '0.5rem' }}></i> Refresh Status
            </button>
            <button onClick={handleFetchAllPdfs} disabled={fetchingAll} style={{ padding: '0.5rem 1rem', borderRadius: '6px', border: 'none', backgroundColor: '#4ECDC4', color: 'white', cursor: 'pointer', fontSize: '12px', fontWeight: '600' }}>
              <i className="fas fa-download" style={{ marginRight: '0.5rem' }}></i> Fetch All
            </button>
          </div>
        </div>

        {/* Tab Content */}
        {activeTab === 'attention' ? (
          <div>
            {/* Active Jobs Mini-Panel */}
            {activeJobs.length > 0 && (
              <div style={{ marginBottom: '1.5rem', padding: '1rem', backgroundColor: 'rgba(78, 205, 196, 0.05)', borderRadius: '8px', border: '1px solid rgba(78, 205, 196, 0.2)' }}>
                <div style={{ fontWeight: 'bold', fontSize: '12px', marginBottom: '0.75rem', display: 'flex', alignItems: 'center', gap: '0.5rem' }}>
                  <i className="fas fa-tasks" style={{ color: '#4ECDC4' }}></i> ACTIVE QUEUE
                </div>
                <div style={{ display: 'flex', flexDirection: 'column', gap: '0.5rem' }}>
                  {activeJobs.slice(0, 3).map(job => (
                    <div key={job.id} style={{ display: 'flex', alignItems: 'center', gap: '1rem', fontSize: '12px' }}>
                      <i className="fas fa-sync fa-spin" style={{ color: '#4ECDC4' }}></i>
                      <span style={{ fontWeight: '600', minWidth: '120px' }}>{job.data.schoolId}</span>
                      <div style={{ flex: 1, height: '4px', backgroundColor: 'var(--bg-secondary)', borderRadius: '2px' }}>
                        <div style={{ width: `${job.progress}%`, height: '100%', backgroundColor: '#4ECDC4', borderRadius: '2px' }}></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Needs Attention Table */}
            {schoolsNeedingAttention.length > 0 ? (
              <div style={{ backgroundColor: 'var(--bg-secondary)', borderRadius: '8px', border: '1px solid var(--border-color)', overflow: 'hidden' }}>
                <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '13px' }}>
                  <thead>
                    <tr style={{ backgroundColor: 'var(--bg-primary)', borderBottom: '1px solid var(--border-color)' }}>
                      <th style={{ padding: '1rem', textAlign: 'left' }}>School</th>
                      <th style={{ padding: '1rem', textAlign: 'center' }}>Drive</th>
                      <th style={{ padding: '1rem', textAlign: 'center' }}>Local</th>
                      <th style={{ padding: '1rem', textAlign: 'left' }}>Issue</th>
                      <th style={{ padding: '1rem', textAlign: 'right' }}>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    {schoolsNeedingAttention.map((result, idx) => {
                      const jobStatus = getJobStatusForSchool(result.schoolId);
                      const isJobActive = jobStatus && (jobStatus.status === 'waiting' || jobStatus.status === 'active');
                      return (
                        <tr key={result.schoolId} style={{ borderBottom: '1px solid var(--border-color)', backgroundColor: idx % 2 === 0 ? 'rgba(0,0,0,0.01)' : 'transparent' }}>
                          <td style={{ padding: '1rem' }}>
                            <div style={{ fontWeight: 'bold' }}>{result.schoolName}</div>
                            <div style={{ fontSize: '11px', color: 'var(--text-secondary)' }}>{result.schoolId}</div>
                          </td>
                          <td style={{ padding: '1rem', textAlign: 'center', fontWeight: 'bold' }}>{result.pdfCount}</td>
                          <td style={{ padding: '1rem', textAlign: 'center', fontWeight: 'bold', color: result.localPdfCount < result.pdfCount ? '#ffa500' : 'inherit' }}>{result.localPdfCount}</td>
                          <td style={{ padding: '1rem' }}>
                            {result.error ? <span style={{ color: '#f44' }}>Error</span> : <span style={{ color: '#ffa500' }}>Out of sync</span>}
                          </td>
                          <td style={{ padding: '1rem', textAlign: 'right' }}>
                            <button onClick={() => handleFetchPdfs(result.schoolId)} disabled={isJobActive} style={{ padding: '0.4rem 0.8rem', backgroundColor: isJobActive ? 'var(--bg-primary)' : '#4ECDC4', color: 'white', border: 'none', borderRadius: '4px', cursor: 'pointer', fontWeight: 'bold', fontSize: '11px' }}>
                              {isJobActive ? 'Syncing...' : 'Sync Now'}
                            </button>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            ) : (
              <div style={{ padding: '4rem', textAlign: 'center', backgroundColor: 'var(--bg-secondary)', borderRadius: '8px' }}>
                <i className="fas fa-check-circle" style={{ fontSize: '3rem', color: '#4ECDC4', marginBottom: '1rem' }}></i>
                <h3>All systems go!</h3>
                <p style={{ color: 'var(--text-secondary)' }}>No schools require immediate action.</p>
              </div>
            )}

            {/* Sub-tools */}
            <div style={{ marginTop: '2rem', display: 'flex', gap: '1rem', flexWrap: 'wrap' }}>
              <button onClick={handleFindStrangeStops} disabled={findingStrangeStops} style={{ padding: '0.75rem 1.25rem', backgroundColor: 'var(--bg-secondary)', border: '1px solid var(--border-color)', borderRadius: '6px', cursor: 'pointer', fontSize: '12px', fontWeight: '600' }}>
                <i className="fas fa-search-location" style={{ marginRight: '0.5rem', color: '#f39c12' }}></i> Find Strange Stops
              </button>
              <button onClick={handleVerifySchoolStops} disabled={verifyingSchoolStops} style={{ padding: '0.75rem 1.25rem', backgroundColor: 'var(--bg-secondary)', border: '1px solid var(--border-color)', borderRadius: '6px', cursor: 'pointer', fontSize: '12px', fontWeight: '600' }}>
                <i className="fas fa-graduation-cap" style={{ marginRight: '0.5rem', color: '#9b59b6' }}></i> Verify School Stops
              </button>
            </div>
          </div>
        ) : (
          /* Inventory Tab */
          <div style={{ backgroundColor: 'var(--bg-secondary)', borderRadius: '8px', border: '1px solid var(--border-color)', overflow: 'hidden' }}>
            <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '13px' }}>
              <thead>
                <tr style={{ backgroundColor: 'var(--bg-primary)', borderBottom: '1px solid var(--border-color)' }}>
                  <th style={{ padding: '1rem', width: '40px' }}></th>
                  <th style={{ padding: '1rem', textAlign: 'left' }}>School</th>
                  <th style={{ padding: '1rem', textAlign: 'center' }}>Local</th>
                  <th style={{ padding: '1rem', textAlign: 'center' }}>Drive</th>
                  <th style={{ padding: '1rem', textAlign: 'center' }}>Processed</th>
                  <th style={{ padding: '1rem', textAlign: 'right' }}>Actions</th>
                </tr>
              </thead>
              <tbody>
                {pdfStatus.schools.map((school: any, idx: number) => {
                  const isExpanded = expandedRows[school.schoolId];
                  const driveInfo = pdfFetchInfo[school.schoolId];
                  const jobStatus = getJobStatusForSchool(school.schoolId);
                  const isJobActive = jobStatus && (jobStatus.status === 'active' || jobStatus.status === 'waiting');
                  
                  return (
                    <React.Fragment key={school.schoolId}>
                      <tr onClick={() => handleRowExpand(school.schoolId)} style={{ borderBottom: '1px solid var(--border-color)', cursor: 'pointer', backgroundColor: idx % 2 === 0 ? 'rgba(0,0,0,0.01)' : 'transparent' }}>
                        <td style={{ padding: '1rem', textAlign: 'center' }}>
                          <i className={`fas ${isExpanded ? 'fa-chevron-down' : 'fa-chevron-right'}`} style={{ fontSize: '10px', color: 'var(--text-tertiary)' }}></i>
                        </td>
                        <td style={{ padding: '1rem' }}>
                          <div style={{ fontWeight: 'bold' }}>{school.schoolName}</div>
                          <div style={{ fontSize: '11px', color: 'var(--text-secondary)' }}>{school.schoolId}</div>
                        </td>
                        <td style={{ padding: '1rem', textAlign: 'center', fontWeight: '600' }}>{school.pdfCount || 0}</td>
                        <td style={{ padding: '1rem', textAlign: 'center' }}>{driveInfo?.drivePdfCount ?? '—'}</td>
                        <td style={{ padding: '1rem', textAlign: 'center' }}>
                          {processingStatus[school.schoolId] ? <i className="fas fa-check-circle" style={{ color: '#4ECDC4' }}></i> : <i className="fas fa-circle" style={{ color: 'rgba(0,0,0,0.05)' }}></i>}
                        </td>
                        <td style={{ padding: '1rem', textAlign: 'right' }}>
                          <button onClick={(e) => { e.stopPropagation(); handleFetchPdfs(school.schoolId); }} disabled={isJobActive} style={{ background: 'none', border: 'none', color: '#4ECDC4', cursor: 'pointer' }}>
                            <i className={`fas ${isJobActive ? 'fa-sync fa-spin' : 'fa-download'}`}></i>
                          </button>
                        </td>
                      </tr>
                      {isExpanded && (
                        <tr style={{ backgroundColor: 'var(--bg-primary)' }}>
                          <td colSpan={6} style={{ padding: '1.5rem' }}>
                            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))', gap: '2rem' }}>
                              <div>
                                <div style={{ fontSize: '10px', fontWeight: 'bold', color: 'var(--text-secondary)', textTransform: 'uppercase', marginBottom: '0.5rem' }}>Status Details</div>
                                <div style={{ fontSize: '12px', display: 'flex', flexDirection: 'column', gap: '0.25rem' }}>
                                  <div>Local Mod: <strong>{driveInfo?.localLastModified ? new Date(driveInfo.localLastModified).toLocaleString() : 'Never'}</strong></div>
                                  <div>Drive Mod: <strong>{driveInfo?.driveLastModified ? new Date(driveInfo.driveLastModified).toLocaleString() : 'Never'}</strong></div>
                                </div>
                              </div>
                              <div>
                                <div style={{ fontSize: '10px', fontWeight: 'bold', color: 'var(--text-secondary)', textTransform: 'uppercase', marginBottom: '0.5rem' }}>Parsed Routes</div>
                                <div style={{ display: 'flex', flexWrap: 'wrap', gap: '0.4rem' }}>
                                  {allRoutes[school.schoolId] ? Object.values(allRoutes[school.schoolId]).map((r: any) => (
                                    <span key={r.id} style={{ padding: '0.2rem 0.5rem', backgroundColor: 'var(--bg-secondary)', borderRadius: '4px', fontSize: '10px' }}>{r.name}</span>
                                  )) : <span style={{ fontStyle: 'italic', fontSize: '11px', color: 'var(--text-tertiary)' }}>No routes loaded</span>}
                                </div>
                              </div>
                            </div>
                          </td>
                        </tr>
                      )}
                    </React.Fragment>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}
