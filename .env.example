# Email Configuration (SMTP)
# Get these values from your Hostinger / Email Provider dashboard
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_email_password
SMTP_FROM=your_email@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# Weekly sync / generated-data publishing
ENABLE_WEEKLY_SYNC=true
ENABLE_GIT_PUBLISH=true
GIT_PUBLISH_PUSH=true
ENABLE_SCHEDULER_CATCHUP=true
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# PostHog analytics
POSTHOG_API_KEY=your_posthog_project_token
POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_UI_HOST=https://us.posthog.com
